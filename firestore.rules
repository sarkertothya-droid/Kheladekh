rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'factsknown178@gmail.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 254 &&
        (!('favoriteSports' in data) || (data.favoriteSports is list && data.favoriteSports.size() <= 30)) &&
        (!('favoriteTeams' in data) || (data.favoriteTeams is list && data.favoriteTeams.size() <= 50)) &&
        (!('savedEvents' in data) || (data.savedEvents is list && data.savedEvents.size() <= 100));
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 4000;
    }

    function isValidMatchMessage(data, eventId, messageId) {
      return data.keys().hasAll(['id', 'eventId', 'userId', 'userName', 'text', 'createdAt']) &&
        data.id is string && data.id == messageId &&
        data.eventId is string && data.eventId == eventId &&
        data.userId is string && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 500)) &&
        (!('teamSupport' in data) || (data.teamSupport is string && data.teamSupport.size() <= 100));
    }

    function isValidActiveSession(data, sessionId) {
      return data.id is string && data.id == sessionId &&
        data.page is string && data.page.size() <= 200 &&
        data.lastPing is number &&
        data.device is string && data.device.size() <= 40 &&
        (!('eventId' in data) || data.eventId == null || (data.eventId is string && data.eventId.size() <= 128)) &&
        (!('eventTitle' in data) || data.eventTitle == null || (data.eventTitle is string && data.eventTitle.size() <= 200)) &&
        (!('sportId' in data) || data.sportId == null || (data.sportId is string && data.sportId.size() <= 80)) &&
        (!('browser' in data) || (data.browser is string && data.browser.size() <= 60)) &&
        (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100));
    }

    // Users collection: PII isolated to owner or admin
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserProfile(request.resource.data);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Publicly readable sports catalog & editorial collections
    match /sports/{sportId} {
      allow get: if isValidId(sportId);
      allow list: if true;
      allow write: if isValidId(sportId) && isAdmin();
    }

    match /teams/{teamId} {
      allow get: if isValidId(teamId);
      allow list: if true;
      allow write: if isValidId(teamId) && isAdmin();
    }

    match /competitions/{competitionId} {
      allow get: if isValidId(competitionId);
      allow list: if true;
      allow write: if isValidId(competitionId) && isAdmin();
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow write: if isValidId(eventId) && isAdmin();

      match /messages/{messageId} {
        allow get, list: if isValidId(eventId);
        allow create: if isValidId(eventId) && isValidId(messageId) && isSignedIn() &&
          isValidMatchMessage(request.resource.data, eventId, messageId);
        allow delete: if isValidId(eventId) && isValidId(messageId) && (
          isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
        );
        allow update: if false;
      }

      match /votes/{userId} {
        allow get, list: if isValidId(eventId);
        allow create, update: if isValidId(eventId) && isValidId(userId) && isOwner(userId);
        allow delete: if isValidId(eventId) && isValidId(userId) && (isOwner(userId) || isAdmin());
      }
    }

    // Active viewer sessions presence tracker (real-time concurrent watchers)
    match /activeSessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sessionId) && isValidActiveSession(request.resource.data, sessionId);
      allow delete: if isValidId(sessionId);
    }

    match /news/{articleId} {
      allow get: if isValidId(articleId);
      allow list: if true;
      allow write: if isValidId(articleId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isValidId(categoryId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Contact messages: anyone can submit, only admins can read/manage
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId) && isValidContactMessage(request.resource.data);
      allow get, list, update, delete: if isAdmin();
    }

    // Audit logs: admin only
    match /auditLogs/{logId} {
      allow read, write: if isValidId(logId) && isAdmin();
    }

    // Admins registry: admin only
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }
  }
}
